<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: 301 the bare domain to https://www. The sitemap, <link
  # rel=canonical> tags, and robots.txt all use www, but the non-www host was
  # serving 200 as well, splitting crawl/index signals across two hosts. This
  # rule only matches the exact bare host, so it cannot loop on www requests.
  RewriteCond %{HTTP_HOST} ^betterhealth\.africa$ [NC]
  RewriteRule ^(.*)$ https://www.betterhealth.africa/$1 [L,R=301]

  # Legacy paths and bare parent paths that have no page of their own. These
  # have to be handled here, above the rules below, for two reasons:
  #
  #   * /pricing and /book are <Route>s in src/App.jsx that render a client-side
  #     <Navigate> to /book-tests, but the 404 rule at the bottom of this file
  #     fires long before React loads, so a direct hit or a crawler got a hard
  #     404 and the redirect never ran. /pricing is linked from 31 blog articles
  #     (and /book from one) in their prerendered, no-JS body, so those internal
  #     links were pointing crawlers straight at a 404.
  #   * /wellness-consultation and /test are real directories in dist/ that hold
  #     only their child pages and no index.html of their own, so they match the
  #     -d condition below, get served, find no DirectoryIndex, and return 403.
  #
  # A server-side 301 is the right answer for all of them anyway: it passes link
  # equity, which a client-side <Navigate> never did. The <Route>s stay in
  # src/App.jsx because in-app navigation (the blog articles use react-router
  # <Link>) never reaches the server. Targets carry a trailing slash to land on
  # the URL LiteSpeed serves as a 200, instead of chaining through mod_dir's own
  # add-the-slash 301. mod_rewrite re-appends the original query string, so utm
  # params and click ids survive the hop.
  RewriteRule ^pricing/?$ /book-tests/ [L,R=301]
  RewriteRule ^book/?$ /book-tests/ [L,R=301]
  RewriteRule ^book/(.+?)/?$ /book-tests/$1/ [L,R=301]
  RewriteRule ^test/?$ /book-tests/ [L,R=301]
  RewriteRule ^wellness-consultation/?$ /wellness-consultation/wellness/ [L,R=301]

  # Serve real files and directories as-is. Every route in ROUTE_SEO is
  # prerendered to dist/<route>/index.html (a real directory), so legitimate
  # pages match here and are served directly with a 200.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Client-only routes with no prerendered file (they exist only in the React
  # router): serve the SPA shell with a 200 so direct entry / hard refresh works.
  # Keep this list in sync with the non-ROUTE_SEO <Route>s in src/App.jsx.
  RewriteRule ^(waitlist|deleteme|ref/.*)/?$ /index.html [L]

  # Everything else is genuinely not found. Return a real 404 status; the
  # ErrorDocument below hands back the SPA shell so React Router still renders
  # the NotFound view for humans. This kills the soft-404 where every unknown
  # URL (mistypes, removed posts, /wp-admin and /.env scans) used to 200 with
  # homepage content and an indexable canonical.
  RewriteRule ^ - [R=404,L]
</IfModule>

# A 404 serves the SPA shell (index.html) but with a 404 HTTP status, so crawlers
# get a correct 404 instead of a soft-200 duplicate of the homepage.
ErrorDocument 404 /index.html

# Baseline security headers (no SEO/routing impact; commonly checked in audits).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS: browsers ignore this over plain HTTP, and all traffic is redirected to
  # HTTPS, so setting it unconditionally is safe. Not preloaded yet.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
