# Google Apps Script Web App URL for waitlist signups
VITE_WAITLIST_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# BetterHealth-Africa backend endpoint for partner signups
# (Doctors, Nutritionists, Lab Owners, and the /foundation Volunteer/Partner/Newsletter
# forms) — uses Resend to email ops@betterhealth.africa
VITE_PARTNER_API_URL=https://api.betterhealth.africa/api/partner-signup

# Public BetterHealth app catalogue used to keep marketing-site test prices in
# sync with the backend. Prices render from static fallbacks first, then refresh
# from this endpoint in the background and cache in-browser.
VITE_PUBLIC_CATALOGUE_API_BASE=https://app.betterhealth.africa/api/public
VITE_PUBLIC_CATALOGUE_COUNTRY=Ghana

# ---------------------------------------------------------------------------
# SEO / GEO program — used ONLY by the nightly automation (seo/tools/*.mjs).
# These are NOT build/runtime app vars; they are read by the data tools and the
# scheduled cloud agent. Never commit real values. See seo/tools/README.md.
# ---------------------------------------------------------------------------

# DataForSEO (paid) — live SERP positions, keyword volumes, competitor data.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
# Optional overrides (default: Ghana / English):
# DFS_LOCATION_CODE=2288
# DFS_LANGUAGE_CODE=en

# Google Search Console (free) — service-account auth (headless, no OAuth popup).
# Accepts base64-of-JSON (best for env vars), inline minified JSON, or a file path.
# For env vars, base64-encode the key: `base64 -i key.json | tr -d '\n'`
# (pretty-printed JSON has newlines that single-line env fields truncate).
GSC_SERVICE_ACCOUNT_JSON=/path/to/gsc-service-account.json
# The GSC property: "https://www.betterhealth.africa/" or "sc-domain:betterhealth.africa"
GSC_SITE_URL=https://www.betterhealth.africa/

# Bing Webmaster Tools (free) — also feeds ChatGPT/Copilot via Bing's index.
BING_API_KEY=your-bing-webmaster-api-key
BING_SITE_URL=https://www.betterhealth.africa/
